<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The player opens in its own task, which Android 12+ starts with a splash screen.
         Keep it plain black so a tap goes straight to the video without an icon flashing. -->
    <style name="PlayerTheme" parent="PlayerThemeBase">
        <item name="android:windowSplashScreenBackground">@android:color/black</item>
        <item name="android:windowSplashScreenAnimatedIcon">@android:color/transparent</item>
    </style>
</resources>

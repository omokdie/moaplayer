<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background" android:gravity="center_vertical" android:height="3dp">
        <shape><solid android:color="#55FFFFFF"/><corners android:radius="2dp"/></shape></item>
    <item android:id="@android:id/secondaryProgress" android:gravity="center_vertical" android:height="3dp">
        <clip><shape><solid android:color="#99FFFFFF"/><corners android:radius="2dp"/></shape></clip></item>
    <item android:id="@android:id/progress" android:gravity="center_vertical" android:height="3dp">
        <clip><shape><solid android:color="@color/accent"/><corners android:radius="2dp"/></shape></clip></item>
</layer-list>
